              "multiplier",
              "damageType"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "heal"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "multiplier"
                ]
              },
              {
                "required": [
                  "percent"
                ]
              },
              {
                "required": [
                  "amount"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "shield"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "multiplier"
                ]
              },
              {
                "required": [
                  "percent"
                ]
              },
              {
                "required": [
                  "amount"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "applyStatus",
                  "removeStatus"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "status"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "buffStat",
                  "debuffStat"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "stat"
            ],
            "anyOf": [
              {
                "required": [
                  "amount"
                ]
              },
              {
                "required": [
                  "percent"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "momentum",
                  "light"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "amount"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pool"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "amount"
                ]
              },
              {
                "required": [
                  "percent"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "timeline"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "energy"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "summon"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "summonId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "revive"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "percent"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loot"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "amount"
                ]
              },
              {
                "required": [
                  "percent"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "custom"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "customId"
            ]
          }
        }
      ]
    },
    "effectList": {
      "type": "array",
      "description": "Effect lines resolved in order.",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "tuningNumber": {
      "description": "A number that is a tuning starting point. Either the bare number, or {value, note} when the reason for the value should travel with it.",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "note"
          ],
          "additionalProperties": false
        }
      ]
    },
    "intRange": {
      "type": "object",
      "description": "An inclusive integer range.",
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "gradeRange": {
      "type": "object",
      "description": "An inclusive range of grades in ladder order.",
      "properties": {
        "min": {
          "$ref": "#/$defs/grade"
        },
        "max": {
          "$ref": "#/$defs/grade"
        }
      },
      "required": [
