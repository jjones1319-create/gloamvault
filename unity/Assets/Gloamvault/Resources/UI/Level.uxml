<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Walk.uss" />
    <ui:VisualElement name="walk" class="walk" picking-mode="Ignore">
        <ui:VisualElement name="panZone" class="walk__panZone" />
        <ui:VisualElement class="walk__top" picking-mode="Ignore">
            <ui:VisualElement class="walk__picker">
                <ui:Label name="room" text="Test level" class="walk__room" />
            </ui:VisualElement>
            <ui:Label name="stats" text="" class="walk__stats" picking-mode="Ignore" />
            <ui:VisualElement class="walk__right">
                <ui:Button name="map" text="Map" class="walk__btn" />
                <ui:Button name="auto" text="Auto walk: off" class="walk__btn" />
                <ui:Button name="camera" text="Camera: normal" class="walk__btn" />
                <ui:Button name="back" text="Back" class="walk__btn walk__btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="minimap" class="walk__minimap" picking-mode="Ignore" />
        <ui:Label name="toast" text="" class="walk__toast" picking-mode="Ignore" />
        <ui:VisualElement class="walk__bottom" picking-mode="Ignore">
            <ui:VisualElement name="stickZone" class="walk__stickZone">
                <ui:VisualElement name="ring" class="walk__ring" picking-mode="Ignore">
                    <ui:VisualElement name="knob" class="walk__knob" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="walk__action" picking-mode="Ignore">
                <ui:Label name="prompt" text="" class="walk__prompt" picking-mode="Ignore" />
                <ui:Button name="a" text="A" class="walk__a" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="mapPanel" class="walk__mapPanel">
            <ui:VisualElement class="walk__mapHead">
                <ui:Label text="The floor, as far as you have been" class="walk__mapTitle" />
                <ui:Button name="mapClose" text="Close" class="walk__btn walk__btn--primary" />
            </ui:VisualElement>
            <ui:VisualElement name="fullMap" class="walk__fullMap" picking-mode="Ignore" />
            <ui:Label text="filled: been there · outline ?: seen through a door · bars: doors (orange: locked or gated, blue: a found panel) · ⌂ the gate · ▼ the stair down · ↗ a way out" class="walk__legend" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
