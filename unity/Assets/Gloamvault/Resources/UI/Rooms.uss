/* The Rooms viewer (Phase 11): a thin top bar and a bottom bar over the room. */
.rooms {
    flex-grow: 1;
    align-self: stretch;
    flex-direction: column;
    justify-content: space-between;
}

.rooms__top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.rooms__title {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
}

.rooms__name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--ember);
    text-shadow: 0 1px 2px #000000;
}

.rooms__zone {
    font-size: 12px;
    color: var(--ink-dim);
    text-shadow: 0 1px 2px #000000;
}

.rooms__arrow {
    width: 64px;
    min-height: 48px;
    font-size: 22px;
    -unity-text-align: middle-center;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: var(--radius);
    color: var(--ink);
}

.rooms__arrow:hover {
    border-color: var(--ember);
}

.rooms__bottom {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.rooms__light {
    flex-direction: column;
    width: 260px;
    padding: 6px 10px;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: var(--radius);
}

.rooms__lightLabel {
    font-size: 12px;
    color: var(--ink-dim);
}

.rooms__slider {
    margin: 0;
    min-height: 28px;
}

.rooms__stats {
    flex-grow: 1;
    margin: 0 12px;
    font-size: 11px;
    color: var(--ink-dim);
    text-shadow: 0 1px 2px #000000;
    -unity-text-align: middle-center;
}

.rooms__btn {
    min-width: 120px;
    min-height: 44px;
    padding: 0 16px;
    -unity-text-align: middle-center;
    background-color: var(--bg-raised);
    border-width: 1px;
    border-color: var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    font-size: 16px;
}

.rooms__btn--primary {
    background-color: var(--ember-deep);
    border-color: #e0702a;
}
